* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Arial, Helvetica, sans-serif;
  background-color: #f4f6fa;
  color: #222;
}

/* HEADER */
header {
  background-color: #1f3a68;
  color: #fff;
  padding: 30px 20px;
  text-align: center;
}

header h1 {
  margin: 0;
}

/* NAV */
nav {
  background-color: #162a4d;
  display: flex;
  justify-content: center;
  gap: 24px;
  padding: 12px;
}

nav a {
  color: #fff;
  text-decoration: none;
}

nav a:hover {
  text-decoration: underline;
}

/* MAIN */
main {
  margin: 30px auto;
  max-width: 1000px;
  padding: 0 20px;
}

/* CARDS (Flexbox) */
.cards {
  display: flex;
  gap: 20px;
  justify-content: space-between;
}

.card {
  flex: 1;
  padding: 20px;
  border: 2px solid #1f3a68;
  border-radius: 8px;
  background-color: #fff;
  transition: background-color 0.3s, border-color 0.3s, color 0.3s;
}

.card h3 {
  margin-top: 0;
}

.card button {
  padding: 8px 14px;
  border: none;
  border-radius: 4px;
  background-color: #1f3a68;
  color: #fff;
  cursor: pointer;
}

.card button:hover {
  background-color: #2f5aa8;
}

/* Estado criado pelo JavaScript */
.card.destacado {
  background-color: #ffe9a8;
  border-color: #e08a00;
  color: #5a3a00;
}

/* ASIDE */
aside {
  margin-top: 30px;
  padding: 20px;
  background-color: #dbe7f7;
  border-radius: 8px;
}

aside h2 {
  margin-top: 0;
}

/* FOOTER */
footer {
  background-color: #1f3a68;
  color: #fff;
  padding: 16px;
  text-align: center;
}

footer p {
  margin: 0;
}

/* Telas pequenas */
@media (max-width: 700px) {
  .cards {
    flex-direction: column;
  }
}
