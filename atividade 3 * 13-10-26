<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Atividade 3 - Responsividade</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      padding: 20px;
    }

    .container {
      display: flex;
      flex-direction: row;
      gap: 20px;
    }

    .coluna {
      flex: 1;
      background-color: #4db6ac;
      color: white;
      padding: 20px;
      border-radius: 8px;
      text-align: center;
    }

    /* Media query para dispositivos móveis (celulares) */
    @media (max-width: 768px) {
      .container {
        flex-direction: column;
      }
    }
  </style>
</head>
<body>

  <div class="container">
    <div class="coluna">
      <h2>Coluna 1</h2>
      <p>Conteúdo da primeira coluna.</p>
    </div>
    <div class="coluna">
      <h2>Coluna 2</h2>
      <p>Conteúdo da segunda coluna.</p>
    </div>
    <div class="coluna">
      <h2>Coluna 3</h2>
      <p>Conteúdo da terceira coluna.</p>
    </div>
  </div>

</body>
</html>
