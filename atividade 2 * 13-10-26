<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Atividade 2 – Destaque de Elemento</title>
  <style>
    .grid-container {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      padding: 10px;
      background-color: #f0f0f0;
    }

    .item {
      background-color: #008080;
      color: white;
      padding: 20px;
      text-align: center;
      font-family: sans-serif;
      font-weight: bold;
      border-radius: 4px;
    }

    .item:first-child {
      grid-column: span 2;
    }
  </style>
</head>
<body>

  <div class="grid-container">
    <div class="item">Item 1 (Ocupa 2 colunas)</div>
    <div class="item">Item 2</div>
    <div class="item">Item 3</div>
    <div class="item">Item 4</div>
  </div>

</body>
</html>
